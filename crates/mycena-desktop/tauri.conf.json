{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mycena",
  "version": "0.1.77",
  "identifier": "io.github.mycena-project.desktop",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "ui"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "ui"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Mycena",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "SocialNetworking",
    "shortDescription": "Communication when the network fails: offline mesh chat and crisis tools",
    "longDescription": "Mycena is an open-source, end-to-end encrypted messenger that keeps working without mobile network or internet. Devices connect directly over Wi-Fi and Bluetooth; crisis mode adds help requests, a resource map and volunteer tasks.",
    "windows": {
      "wix": { "language": "en-US" }
    },
    "macOS": {
      "signingIdentity": null,
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "deb": { "depends": ["libwebkit2gtk-4.1-0", "libssl-dev"] },
      "appimage": { "bundleMediaFramework": true }
    }
  }
}
